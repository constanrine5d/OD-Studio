  "Unknowns": {
   "name": "Unknowns",
   "descriptor": "Factor",
   "units": "",
   "columns": [
    {
     "name": "Sample",
     "formula": "!SampleNames",
     "decimals": null,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Factor",
     "formula": "!Factor",
     "decimals": 3,
     "hidden": false,

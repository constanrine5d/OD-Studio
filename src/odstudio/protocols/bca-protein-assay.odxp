    },
    {
     "name": "Wells",
     "formula": "!WellIDs",
     "decimals": null,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Values",
     "formula": "!WellValues",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "MeanValue",
     "formula": "Average(Values)",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Std.Dev.",
     "formula": "Stdev(Values)",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "CV%",
     "formula": "Cv(Values)",
     "decimals": 1,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Result",
     "formula": "InterpX(STD@'Standard Curve',Values)",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "MeanResult",
     "formula": "Average(Result)",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Adj.Result",
     "formula": "MeanResult*!Factor",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Range",
     "formula": "If(MeanValue<MinStd@Standards or MeanValue>MaxStd@Standards,\"outside curve\",\"\")",
     "decimals": null,
     "hidden": false,
     "style": {}
    }
   ],
   "summaries": [
    {
     "name": "Note",
     "formula": "\"\"",
     "description": "Adj.Result = MeanResult \u00d7 dilution factor (mg/ml). Set each sample's Factor in the template.",
     "decimals": 0,
     "hide_name": true,
     "style": {}
    }

 "next_id": 7,
 "sections": [
  {
   "id": 6,
   "kind": "notes",
   "report": true,
   "open": true,
   "name": "Protocol",
   "html": "<h2>Sandwich ELISA (TMB), 450 nm with 650 nm reference</h2><p>Read after adding acid stop solution to the TMB substrate. The reduction subtracts the 650 nm reading (plate imperfections, scratches) from the 450 nm signal: L1\u2212L2.</p><p><b>Layout.</b> Standards as a 2-fold dilution series from 1000 pg/ml in rows A\u2013G of columns 1\u20132; zero standard (H1\u2013H2) is the plate blank. Unknowns in duplicate pairs of columns 3\u201312.</p><p><b>Curve.</b> 4-parameter logistic fit weighted 1/Y\u00b2, with confidence bands. Change the top standard in the template (Series) to match your kit.</p><p>Follow your kit's instructions for incubation times, washes and dilutions.</p>",
   "summaries": [],
   "show_formulas": false
  },
  {
   "id": 1,
   "kind": "plate",
   "report": true,
   "open": true,
   "name": "ELISA",
   "settings": {
    "mode": "endpoint",
    "wavelengths": [
     450,
     650
    ],
    "run_time": 300,
    "interval": 30,
    "first_col": 1,
    "last_col": 12,
    "mix_before": false,
    "mix_before_s": 5,
    "mix_between": false,
    "mix_between_s": 3,
    "autocalibrate": true,
    "pre_read": false,
    "start": 350,
    "stop": 750,
    "step": 10,
    "delay": 0,
    "wait_temp": false,
    "columns": null
   },

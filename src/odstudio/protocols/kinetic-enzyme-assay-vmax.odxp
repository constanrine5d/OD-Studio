 "groups": {
  "Samples": {
   "name": "Samples",
   "descriptor": "Factor",
   "units": "",
   "columns": [
    {
     "name": "Sample",
     "formula": "!SampleNames",
     "decimals": null,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Factor",
     "formula": "!Factor",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Wells",
     "formula": "!WellIDs",
     "decimals": null,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Values",
     "formula": "!WellValues",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "MeanValue",
     "formula": "Average(Values)",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Std.Dev.",
     "formula": "Stdev(Values)",
     "decimals": 3,
     "hidden": false,
     "style": {}
    },
    {
     "name": "CV%",
     "formula": "Cv(Values)",
     "decimals": 1,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Rate (OD/min)",
     "formula": "MeanValue/1000",
     "decimals": 5,
     "hidden": false,
     "style": {}
    },
    {
     "name": "Activity",
     "formula": "MeanValue/1000/(Epsilon@Samples*Path@Samples)*!Factor*1000",
     "decimals": 4,
     "hidden": false,
     "style": {}
    }
   ],
   "summaries": [
    {
     "name": "Epsilon",
     "formula": "18.5",
     "description": "Extinction coefficient (mM\u207b\u00b9 cm\u207b\u00b9) \u2014 edit:",
     "decimals": 2,
     "hide_name": false,
     "style": {}
    },
    {
     "name": "Path",
     "formula": "0.6",
     "description": "Light path (cm) for your volume \u2014 edit:",
     "decimals": 2,
     "hide_name": false,
     "style": {}
    }
   ],
   "hide_replicates": false,
   "show_formulas": false,
   "color": "#4f8ad9"
  }
